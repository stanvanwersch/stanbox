<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Droogtekaart</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(function(){
  function pref(){
    try{ var s=localStorage.getItem('fcab-water-theme'); if(s==='dark'||s==='light') return s; }catch(e){}
    return 'light';
  }
  document.documentElement.setAttribute('data-theme', pref());
  window.toggleTheme=function(){
    var cur=document.documentElement.getAttribute('data-theme')==='dark'?'dark':'light';
    var next=cur==='dark'?'light':'dark';
    document.documentElement.setAttribute('data-theme',next);
    try{ localStorage.setItem('fcab-water-theme',next); }catch(e){}
  };
})();
</script>
<style>
:root{
  --cream:#faf9f7;--white:#ffffff;--border:#e8e4de;--border2:#d4cfc8;
  --text:#1c1a17;--text2:#5a5650;--text3:#9c9690;
  --accent:#e07a2f;--accent-s:rgba(224,122,47,.09);--accent-b:rgba(224,122,47,.22);
  --blue:#1d5fa8;--blue-s:rgba(29,95,168,.07);--blue-b:rgba(29,95,168,.18);
  --green:#1a6e3c;--amber:#b45309;--red:#b91c1c;
  --red-s:rgba(185,28,28,.07);--red-b:rgba(185,28,28,.16);
  --sans:'Inter',system-ui,-apple-system,sans-serif;
  --wordmark:'Poppins',system-ui,sans-serif;
  --r:10px;--r-sm:6px;
  --topbar-bg:rgba(255,255,255,.78);
  --hover-tint:rgba(0,0,0,.02);
  --shadow-soft:rgba(28,26,23,.08);
  --shadow-card:rgba(0,0,0,.1);
  --neutral-s:#f0ede8;
}
html[data-theme="dark"]{
  --cream:#1a1815;--white:#242220;--border:#3a3630;--border2:#4a453d;
  --text:#f1eee8;--text2:#b7b1a7;--text3:#837d73;
  --topbar-bg:rgba(36,34,32,.78);
  --hover-tint:rgba(255,255,255,.045);
  --shadow-soft:rgba(0,0,0,.4);
  --shadow-card:rgba(0,0,0,.45);
  --neutral-s:#33302a;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{color-scheme:light;}
html[data-theme="dark"]{color-scheme:dark;}
html,body{height:100%;font-family:var(--sans);background:var(--cream);color:var(--text);font-size:14px;}
::selection{background:var(--accent-b);}
::-webkit-scrollbar{width:6px;height:6px;}
::-webkit-scrollbar-track{background:var(--cream);}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px;}

.icon-btn{
  width:34px;height:34px;flex-shrink:0;border-radius:50%;
  border:1px solid var(--border);background:var(--white);color:var(--text2);
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  transition:color .15s,border-color .15s,background .15s,transform .15s;
  text-decoration:none;overflow:hidden;
}
.icon-btn:hover{color:var(--accent);border-color:var(--accent-b);background:var(--accent-s);transform:translateY(-1px);}
.icon-btn img{width:70%;height:70%;object-fit:contain;}
.theme-toggle .ti-sun{display:none;}
html[data-theme="dark"] .theme-toggle .ti-moon{display:none;}
html[data-theme="dark"] .theme-toggle .ti-sun{display:block;}

/* LOADER */
#loader{position:fixed;inset:0;z-index:9999;background:var(--cream);display:flex;
  flex-direction:column;align-items:center;justify-content:center;gap:14px;}
#loader .ld-logo img{height:52px;}
#loader .ld-txt{font-size:12.5px;color:var(--text2);font-weight:300;}
.ld-bar{width:200px;height:3px;background:var(--border);border-radius:3px;overflow:hidden;}
.ld-bar div{height:100%;width:40%;background:var(--accent);animation:ld 1.1s ease-in-out infinite;}
@keyframes ld{0%{transform:translateX(-100%)}100%{transform:translateX(350%)}}

#app{display:none;height:100vh;flex-direction:column;background:var(--cream);}

/* TOPBAR */
.topbar{
  background:var(--topbar-bg);
  backdrop-filter:blur(14px) saturate(160%);-webkit-backdrop-filter:blur(14px) saturate(160%);
  margin:12px 12px 0 12px;border-radius:16px;box-shadow:0 4px 20px var(--shadow-soft);
  padding:0 20px;height:60px;flex-shrink:0;
  display:flex;align-items:center;justify-content:space-between;position:relative;z-index:600;
}
.logo{display:flex;align-items:center;gap:10px;}
.logo img{height:34px;width:auto;}
.logo-text{display:flex;flex-direction:column;}
.logo-name{font-size:13.5px;font-weight:600;color:var(--text);letter-spacing:-.1px;}
.logo-sub{font-size:10px;color:var(--text3);}
.topbar-right{display:flex;align-items:center;gap:10px;}
.topbar-btn{
  background:var(--white);border:1px solid var(--border2);border-radius:var(--r-sm);
  padding:7px 14px;font-family:var(--sans);font-size:11.5px;font-weight:500;
  color:var(--text2);cursor:pointer;transition:all .13s;
}
.topbar-btn.blue{background:var(--blue);color:#fff;border-color:var(--blue);}
.topbar-btn.blue:hover{opacity:.85;}
.topbar-btn:hover{border-color:var(--accent-b);color:var(--accent);}

/* MAIN */
.main{flex:1;display:flex;overflow:hidden;margin:8px 12px 12px 12px;gap:12px;}
.panel{
  width:308px;flex-shrink:0;background:var(--white);
  border-radius:14px;box-shadow:0 2px 12px var(--shadow-soft);
  display:flex;flex-direction:column;overflow:hidden;
}
.panel-header{padding:12px 14px 11px;border-bottom:1px solid var(--border);}
.tabs{display:flex;gap:4px;background:var(--cream);border-radius:8px;padding:3px;margin-bottom:10px;}
.tab{
  flex:1;text-align:center;padding:5px 0;font-size:11.5px;font-weight:600;
  color:var(--text3);border-radius:6px;cursor:pointer;transition:all .13s;border:none;background:none;
  font-family:var(--sans);
}
.tab.on{background:var(--white);color:var(--accent);box-shadow:0 1px 4px var(--shadow-soft);}
.search-wrap{
  position:relative;display:flex;align-items:center;gap:6px;
  border:1px solid var(--border2);border-radius:20px;background:var(--cream);padding:0 12px;
  transition:border-color .15s,background .15s;
}
.search-wrap:focus-within{border-color:var(--accent);background:var(--white);}
.search-input{
  flex:1;min-width:0;width:100%;padding:7px 2px;border:none;background:transparent;
  font-family:var(--sans);font-size:12.5px;color:var(--text);outline:none;
}
.search-input::placeholder{color:var(--text3);}
.search-ico{flex-shrink:0;color:var(--text3);}
.ctrl-row{display:flex;gap:6px;margin-top:9px;}
.sort-sel{
  font-family:var(--sans);font-size:11px;color:var(--text2);
  border:1px solid var(--border);border-radius:var(--r-sm);
  padding:5px 6px;background:var(--cream);cursor:pointer;outline:none;flex:1;min-width:0;
}
.sort-sel:hover{border-color:var(--border2);}
.filter-btns{display:flex;gap:5px;flex-wrap:wrap;margin-top:9px;}
.filter-btn{
  padding:3px 10px;border:1px solid var(--border);border-radius:20px;
  font-family:var(--sans);font-size:10.5px;font-weight:500;color:var(--text2);
  background:var(--cream);cursor:pointer;transition:all .13s;
}
.filter-btn:hover{border-color:var(--border2);}
.filter-btn.on{background:var(--blue);color:#fff;border-color:var(--blue);}
.chk-row{display:flex;align-items:center;gap:6px;margin-top:9px;font-size:10.5px;color:var(--text2);cursor:pointer;}
.chk-row input{accent-color:var(--accent);cursor:pointer;}
.list-count{font-size:10px;color:var(--text3);margin-top:8px;}
.list{flex:1;overflow-y:auto;}
.list-hint{padding:16px;font-size:12px;color:var(--text3);font-weight:300;font-style:italic;line-height:1.5;}
.li{
  padding:9px 14px;border-bottom:1px solid var(--border);cursor:pointer;
  display:flex;align-items:center;gap:9px;transition:background .12s;
}
.li:hover{background:var(--cream);}
.li.active{background:var(--blue-s);box-shadow:inset 3px 0 0 var(--blue);}
.li-rank{font-size:9.5px;color:var(--text3);width:26px;flex-shrink:0;font-variant-numeric:tabular-nums;}
.li-body{flex:1;min-width:0;}
.li-name{font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.li-sub{font-size:10.5px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.li-val{
  font-size:9.5px;font-weight:600;padding:3px 7px;border-radius:20px;flex-shrink:0;
  min-width:56px;text-align:center;white-space:nowrap;
}

/* DETAIL */
.detail{display:none;flex-direction:column;overflow-y:auto;flex:1;}
.detail.open{display:flex;}
.d-head{padding:12px 14px 10px;border-bottom:1px solid var(--border);background:var(--cream);}
.d-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;}
.d-name{font-size:14px;font-weight:600;color:var(--text);line-height:1.25;}
.d-sub{font-size:11px;color:var(--text3);margin-top:2px;}
.d-close{background:none;border:none;font-size:19px;color:var(--text3);cursor:pointer;line-height:1;flex-shrink:0;}
.d-close:hover{color:var(--red);}
.d-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:11px 14px;}
.d-kpi{background:var(--cream);border:1px solid var(--border);border-radius:var(--r-sm);padding:7px 8px;text-align:center;}
.d-kpi-num{font-size:15px;font-weight:700;line-height:1.1;font-variant-numeric:tabular-nums;color:var(--text);}
.d-kpi-lbl{font-size:8.5px;color:var(--text3);margin-top:2px;letter-spacing:.2px;line-height:1.25;}
.d-kpi-klasse{font-size:12.5px;line-height:1.15;}
.d-sec{padding:0 14px 12px;}
.d-sec-title{font-size:9.5px;font-weight:600;letter-spacing:.6px;color:var(--text3);margin:10px 0 7px;}
.kl-row{display:flex;align-items:center;gap:7px;margin-bottom:5px;}
.kl-sw{width:10px;height:10px;border-radius:2px;border:1px solid var(--border2);flex-shrink:0;}
.kl-name{font-size:10.5px;color:var(--text2);flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.kl-bar{width:52px;height:5px;background:var(--border);border-radius:3px;overflow:hidden;flex-shrink:0;}
.kl-bar div{height:100%;}
.kl-num{font-size:10px;color:var(--text);font-weight:600;width:62px;text-align:right;flex-shrink:0;font-variant-numeric:tabular-nums;}
.d-note{font-size:10.5px;color:var(--text2);line-height:1.5;background:var(--cream);
  border:1px solid var(--border);border-radius:var(--r-sm);padding:8px 10px;font-weight:300;}
.d-note b{font-weight:600;color:var(--text);}
.d-link{display:block;margin-top:8px;font-size:11px;color:var(--blue);cursor:pointer;text-decoration:none;font-weight:500;}
.d-link:hover{text-decoration:underline;}

/* MAP */
.map-container{flex:1;position:relative;border-radius:14px;overflow:hidden;box-shadow:0 2px 12px var(--shadow-soft);}
#map{width:100%;height:100%;background:var(--cream);}
html[data-theme="dark"] .leaflet-tile-pane{filter:brightness(.72) saturate(.85) contrast(1.05);}
html[data-theme="dark"] .leaflet-control-attribution{background:rgba(36,34,32,.82)!important;color:var(--text2)!important;}
html[data-theme="dark"] .leaflet-control-attribution a{color:var(--text2)!important;}
html[data-theme="dark"] .leaflet-bar a{background:var(--white);color:var(--text);border-color:var(--border);}
.leaflet-container{font-family:var(--sans);}

.stats-bar{position:absolute;bottom:14px;left:12px;z-index:500;display:flex;gap:8px;}
.stat-card{
  background:var(--white);border:1px solid var(--border);border-radius:var(--r-sm);
  padding:7px 12px;box-shadow:0 4px 14px var(--shadow-card);text-align:center;min-width:66px;
}
.stat-num{font-size:15px;font-weight:700;color:var(--accent);line-height:1;font-variant-numeric:tabular-nums;}
.stat-lbl{font-size:9.5px;color:var(--text3);margin-top:2px;}

.legend{
  position:absolute;bottom:14px;right:12px;z-index:500;
  background:var(--white);border:1px solid var(--border);border-radius:var(--r-sm);
  padding:10px 13px;box-shadow:0 6px 20px var(--shadow-card);max-width:220px;
}
.legend-head{margin-bottom:7px;}
.legend-title{font-size:9.5px;font-weight:600;letter-spacing:.6px;color:var(--text3);}
.legend-caret{display:none;font-size:11px;color:var(--text3);transition:transform .15s;}
.sheet-handle{display:none;}
.legend-items{display:flex;flex-direction:column;gap:3px;}
.legend-item{display:flex;align-items:center;gap:6px;font-size:10.5px;color:var(--text2);}
.legend-sw{width:14px;height:11px;border-radius:2px;flex-shrink:0;border:1px solid rgba(0,0,0,.25);}
.legend-foot{font-size:9.5px;color:var(--text3);margin-top:7px;padding-top:6px;border-top:1px solid var(--border);line-height:1.4;}

.hover-tip{
  position:absolute;z-index:520;pointer-events:none;background:var(--white);
  border:1px solid var(--border2);border-radius:var(--r-sm);padding:6px 9px;
  box-shadow:0 6px 18px var(--shadow-card);font-size:11px;color:var(--text);display:none;
  max-width:230px;
}
.hover-tip .ht-sub{font-size:10px;color:var(--text3);margin-top:1px;}
.hover-tip .ht-val{font-size:11px;font-weight:700;margin-top:3px;color:var(--accent);}

/* ---------- mobiel: kaart als hoofdoppervlak, lijst als bottom sheet ---------- */
@media (hover:none){
  .hover-tip{display:none!important;}
}
@media (max-width:820px){
  #app{height:100vh;height:100dvh;}
  .topbar{height:52px;margin:8px 8px 0 8px;padding:0 14px;border-radius:14px;}
  .logo img{height:26px;}
  .logo-name{font-size:12.5px;}
  .icon-btn{width:36px;height:36px;}

  .main{position:relative;flex-direction:column;margin:8px;gap:0;}
  .map-container{position:absolute;inset:0;border-radius:12px;}

  /* boven de Leaflet-controls, anders vangen die de tikken op de lijst op */
  .panel{
    position:absolute;left:0;right:0;bottom:0;width:auto;z-index:1200;
    border-radius:16px 16px 12px 12px;box-shadow:0 -8px 28px var(--shadow-card);
    transition:height .22s ease;
  }
  /* attributie naar linksboven, zodat de sheet die niet bedekt */
  .leaflet-bottom.leaflet-right{bottom:132px;left:6px;right:auto;top:auto;}
  .leaflet-control-attribution{font-size:8.5px;max-width:64vw;line-height:1.3;padding:1px 5px;opacity:.85;}
  .panel.sheet-collapsed{height:124px;}
  .panel.sheet-half{height:54%;}
  .panel.sheet-full{height:88%;}

  .sheet-handle{
    display:flex;align-items:center;justify-content:center;
    padding:9px 0 5px;flex-shrink:0;cursor:pointer;
  }
  .sheet-grip{width:38px;height:4px;border-radius:3px;background:var(--border2);display:block;}

  .panel-header{padding:6px 12px 10px;}
  .tabs{margin-bottom:8px;}
  .tab{padding:8px 0;font-size:12.5px;}
  /* 16px voorkomt dat iOS bij focus inzoomt */
  .search-input{font-size:16px;padding:8px 2px;}
  .sort-sel{font-size:16px;padding:7px 6px;}
  .filter-btn{padding:6px 12px;font-size:12px;}
  .chk-row{font-size:12px;padding:3px 0;}
  .list-count{font-size:11px;}
  .li{padding:12px 14px;gap:10px;}
  .li-rank{width:22px;font-size:10.5px;}
  .li-name{font-size:13px;}
  .li-sub{font-size:11.5px;}

  .stats-bar{display:none;}
  .legend{top:10px;right:10px;bottom:auto;max-width:62%;padding:9px 11px;z-index:1100;}
  .legend-head{display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;margin-bottom:0;}
  .legend-caret{display:block;}
  .legend-items{margin-top:7px;}
  .legend-item{font-size:11px;}
  .legend.collapsed .legend-items,.legend.collapsed .legend-foot{display:none;}
  .legend.collapsed .legend-caret{transform:rotate(-90deg);}

  .d-head{padding:10px 12px 9px;}
  .d-kpis{padding:10px 12px;gap:5px;}
  .d-kpi-num{font-size:14px;}
  .d-kpi-klasse{font-size:11px;}
  .panel.detail-open .panel-header{display:none;}
  .d-sec{padding:0 12px 14px;}
  .kl-name{font-size:11px;}
  .kl-bar{width:28px;}
  .kl-num{width:74px;font-size:10px;}
  .kl-row{gap:6px;margin-bottom:6px;}
  .d-note{font-size:11.5px;}
  .d-link{font-size:12.5px;padding:6px 0;}
  .leaflet-control-attribution{font-size:9px;max-width:52%;}
}
@media (max-width:420px){
  .panel.sheet-collapsed{height:118px;}
  .legend{max-width:70%;}
  .filter-btn{padding:5px 10px;font-size:11.5px;}

}
</style>
</head>
<body>

<div id="loader">
  <div class="ld-logo"><img id="ld-logo-img" alt="FCAB"></div>
  <div class="ld-txt" id="ld-txt">Laarzen aantrekken&hellip;</div>
  <div class="ld-bar"><div></div></div>
</div>

<div id="app">
  <div class="topbar">
    <div class="logo">
      <img id="topbar-logo-img" alt="FCAB">
      <div class="logo-text">
        <div class="logo-name">Droogtekaart</div>
      </div>
    </div>
    <div class="topbar-right">
      <button type="button" class="icon-btn theme-toggle" onclick="toggleTheme()" aria-label="Wissel donkere modus" title="Licht / donker">
        <svg class="ti-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="ti-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>
    </div>
  </div>

  <div class="main">
    <div class="panel sheet-half" id="panel">
      <div class="sheet-handle" id="sheet-handle">
        <span class="sheet-grip"></span>
      </div>
      <div class="panel-header">
        <div class="tabs">
          <button class="tab on" id="tab-buurt" data-mode="buurt">Buurten</button>
          <button class="tab" id="tab-gem" data-mode="gemeente">Gemeenten</button>
        </div>
        <div class="search-wrap">
          <input class="search-input" id="q" type="text" placeholder="Buurt, gemeente of buurtcode...">
          <svg class="search-ico" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </div>
        <div class="ctrl-row">
          <select class="sort-sel" id="sort-sel"></select>
        </div>
        <div class="filter-btns" id="filter-row">
          <button class="filter-btn on" data-f="all">Alle</button>
          <button class="filter-btn" data-f="4">Niet helemaal droog</button>
          <button class="filter-btn" data-f="2">Natte voeten</button>
          <button class="filter-btn" data-f="0">Laarzen aan</button>
        </div>
        <label class="chk-row"><input type="checkbox" id="chk-min" checked><span>Alleen buurten met &ge; 50 panden met bekende diepte</span></label>
        <div class="list-count" id="list-count"></div>
      </div>
      <div class="list" id="list"></div>
      <div class="detail" id="detail">
        <div class="d-head">
          <div class="d-top">
            <div>
              <div class="d-name" id="d-name"></div>
              <div class="d-sub" id="d-sub"></div>
              <div class="d-sub" id="d-sub2"></div>
            </div>
            <button class="d-close" id="d-close">&times;</button>
          </div>
        </div>
        <div class="d-kpis" id="d-kpis"></div>
        <div class="d-sec">
          <div class="d-sec-title">Waar komt het water? (% van bekend)</div>
          <div id="d-klassen"></div>
          <div class="d-sec-title">In context</div>
          <div class="d-note" id="d-context"></div>
          <a class="d-link" id="d-zoom">Inzoomen op de kaart &rarr;</a>
        </div>
      </div>
    </div>

    <div class="map-container">
      <div id="map"></div>
      <div class="stats-bar" id="stats-bar"></div>
      <div class="legend" id="legend">
        <div class="legend-head" id="legend-head">
          <div class="legend-title" id="legend-title">Legenda</div>
          <span class="legend-caret">&#9662;</span>
        </div>
        <div class="legend-items" id="legend-items"></div>
