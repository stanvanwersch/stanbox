  --text:#eef1f2; --text2:#b8c2c6; --text3:#7f8b90;
  --phase1:#7fb3c8; --phase2:#e08a6c; --phase3:#4cc4bc;
  --phase1-s:rgba(127,179,200,.12); --phase2-s:rgba(224,138,108,.12); --phase3-s:rgba(76,196,188,.12);
  --water1:#6aa6d6; --water2:#4f8fe0; --water3:#8aa4ff;
  --grid:#2c3337; --hatch:#2f7f78; --hatch-bg:#183331;
  --shadow:rgba(0,0,0,.4); color-scheme:dark;
}}
:root[data-theme="dark"]{
  --bg-photo-tint:rgba(6,10,12,.72);
  --cream:#171b1d; --white:#21272a; --border:#323a3e; --border2:#435056;
  --text:#eef1f2; --text2:#b8c2c6; --text3:#7f8b90;
  --phase1:#7fb3c8; --phase2:#e08a6c; --phase3:#4cc4bc;
