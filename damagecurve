*{box-sizing:border-box}
html,body{margin:0}
body{font-family:var(--sans);font-size:15px;line-height:1.6;color:var(--text);background:var(--cream);
  padding-inline:16px;padding-block:16px;min-height:100%}
.bg-photo{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:linear-gradient(180deg,var(--bg-photo-tint),var(--bg-photo-tint)),url(data:image/jpeg;base64,) center/cover}
.page{position:relative;z-index:1;max-width:1180px;margin:0 auto;background:var(--cream);border-radius:var(--r-lg);
  box-shadow:0 24px 70px rgba(0,0,0,.35);overflow:clip}
h1,h2,h3{font-family:var(--display);text-wrap:balance;margin:0;color:var(--text)}
button,input,select{font-family:var(--sans);font-size:14px;color:var(--text)}
:focus-visible{outline:2px solid var(--phase1);outline-offset:2px}
.num{font-variant-numeric:tabular-nums}

/* topbar */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:20px 32px;border-bottom:1.5px solid var(--border)}
.brand{display:flex;align-items:center;gap:14px;min-width:0}
.mark{display:grid;grid-template-columns:1fr 1fr;gap:3px;flex:none}
.mark i{width:13px;height:13px;border-radius:3px;display:block}
.brand-name{font-family:var(--display);font-weight:600;font-size:22px;line-height:1.2;margin:2px 0 0}
.brand-sub{font-size:13px;color:var(--text3)}
.top-right{display:flex;align-items:center;gap:10px}
.badge{font-family:var(--display);font-size:13px;font-weight:600;font-style:italic;color:#fff;background:var(--phase2);padding:4px 12px;border-radius:20px}
.icon-btn{width:36px;height:36px;border-radius:50%;border:1px solid var(--border);background:var(--white);cursor:pointer;display:grid;place-items:center;color:var(--text2)}
.icon-btn:hover{color:var(--text)}

/* intro + KPI */
.intro{padding:28px 32px 8px;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:28px;align-items:end}
.eyebrow{font-size:12px;font-weight:500;color:var(--text3);letter-spacing:.3px;margin-bottom:6px}
.intro h1{font-size:30px;line-height:1.15;font-weight:600}
.intro p{color:var(--text2);margin:10px 0 0;max-width:62ch}
.kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.kpi{background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:12px 14px}
.kpi .l{font-size:12px;color:var(--text3);font-weight:500}
.kpi .v{font-family:var(--display);font-size:22px;font-weight:600;line-height:1.2;margin-top:2px}
.kpi .v small{font-family:var(--sans);font-size:12px;font-weight:400;color:var(--text3)}
.kpi.good .v{color:var(--phase3)} .kpi.bad .v{color:var(--phase2)}

/* sticky stepper */
.stepper{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--cream);padding:14px 32px;border-bottom:1px solid var(--border);
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.ph{border-radius:14px;padding:8px 10px 10px;background:var(--ps)}
.ph .pn{font-family:var(--display);font-size:12.5px;font-weight:600;color:var(--pc);margin:0 4px 6px}
.ph .row{display:flex;gap:6px}
.sbtn{flex:1;min-width:0;display:flex;align-items:center;gap:8px;border:1px solid var(--border);background:var(--white);border-radius:10px;padding:7px 9px;cursor:pointer;text-align:left;font-size:12.5px;line-height:1.25;color:var(--text2)}
.sbtn b{flex:none;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-size:12px;color:#fff;background:var(--pc)}
.sbtn span{overflow:hidden;text-overflow:ellipsis}
.sbtn.on{border-color:var(--pc);color:var(--text);box-shadow:0 0 0 1px var(--pc)}
.p1{--pc:var(--phase1);--ps:var(--phase1-s)} .p2{--pc:var(--phase2);--ps:var(--phase2-s)} .p3{--pc:var(--phase3);--ps:var(--phase3-s)}

/* steps */
.steps{padding:8px 32px 24px;display:flex;flex-direction:column;gap:22px}
.phase-label{display:flex;align-items:center;gap:10px;margin-top:18px;font-family:var(--display);font-weight:600;font-size:14px;color:var(--pc)}
.phase-label::after{content:"";flex:1;height:2px;background:var(--pc);opacity:.35;border-radius:2px}
.step{background:var(--white);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:0 4px 20px var(--shadow);scroll-margin-top:150px}
.step-h{display:flex;align-items:center;gap:12px;padding:18px 22px 10px}
.step-h .n{width:34px;height:34px;border-radius:50%;background:var(--pc);color:#fff;font-family:var(--display);font-weight:600;display:grid;place-items:center;flex:none}
.step-h h2{font-size:19px;font-weight:600}
.step-h p{margin:0;color:var(--text3);font-size:13px}
.ipo{display:grid;grid-template-columns:minmax(0,1fr) 34px minmax(0,1.05fr) 34px minmax(0,1.15fr);padding:6px 22px 22px;align-items:stretch}
.col{min-width:0;border-radius:var(--r);padding:14px 16px;display:flex;flex-direction:column;gap:10px}
.col.in{background:var(--cream);border:1px solid var(--border)}
.col.pr{background:var(--ps);border:1px dashed var(--pc)}
.col.out{background:var(--white);border:1.5px solid var(--pc)}
.col-t{font-size:11.5px;font-weight:600;color:var(--pc)}
.col.in .col-t{color:var(--text3)}
.arrow{display:grid;place-items:center;color:var(--text3)}
.f{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:4px 10px;font-size:13.5px}
.f label{color:var(--text2)}
.f .val{font-weight:600;font-variant-numeric:tabular-nums;min-width:62px;text-align:right}
.f input[type=range]{grid-column:1/-1;width:100%;accent-color:var(--pc);margin:0}
.chk{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:4px 10px;align-items:start;font-size:13.5px;padding:8px 10px;border:1px solid var(--border);border-radius:10px;background:var(--white);cursor:pointer}
.chk input{margin:3px 0 0;accent-color:var(--pc)}
.chk small{grid-column:2/-1;color:var(--text3);font-size:12px;line-height:1.35}
.chk .c{font-weight:600;font-variant-numeric:tabular-nums}
.chk.lvl{font-size:11px;font-weight:600;color:var(--text3)}
.seg{display:inline-flex;background:var(--white);border:1px solid var(--border);border-radius:999px;padding:3px;gap:2px}
.seg button{border:0;background:transparent;border-radius:999px;padding:5px 11px;font-size:12.5px;color:var(--text3);cursor:pointer}
.seg button.on{background:var(--pc);color:#fff}
.formula{font-family:ui-monospace,'SF Mono',Consolas,monospace;font-size:12.5px;background:var(--white);border:1px solid var(--border);border-radius:8px;padding:8px 10px;color:var(--text);overflow-x:auto;white-space:pre}
.pr p,.pr li{font-size:13px;color:var(--text2);margin:0}
.pr ol{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:4px}
.src{font-size:11.5px;color:var(--text3)}
.tbl{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
.tbl th{text-align:left;font-weight:500;color:var(--text3);font-size:12px;padding:3px 4px;border-bottom:1px solid var(--border)}
.tbl td{padding:4px;border-bottom:1px solid var(--grid)} .tbl td.r,.tbl th.r{text-align:right}
.big{font-family:var(--display);font-size:24px;font-weight:600;line-height:1.15}
.big small{font-family:var(--sans);font-size:12.5px;font-weight:400;color:var(--text3)}
.pill{display:inline-block;font-size:12px;font-weight:600;padding:2px 9px;border-radius:999px;background:var(--ps);color:var(--pc)}
.pill.warn{background:var(--phase2-s);color:var(--phase2)} .pill.ok{background:var(--phase3-s);color:var(--phase3)}
svg.ch{width:100%;height:auto;display:block}
svg.ch text{font-family:var(--sans);fill:var(--text3);font-size:11px}
svg.ch .lab{fill:var(--text);font-weight:600}
svg.ch .grid{stroke:var(--grid)}
.foot{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:20px 32px 26px;border-top:1.5px solid var(--border)}
.foot p{margin:0;font-size:12.5px;color:var(--text3);max-width:60ch}
.logos{display:flex;align-items:center;gap:26px;flex-wrap:wrap;background:#fff;border-radius:14px;padding:10px 18px}
.logos img{height:34px;width:auto;display:block}

@media (max-width:900px){
  .intro{grid-template-columns:1fr}
  .stepper{grid-template-columns:1fr;position:static}
  .ipo{grid-template-columns:minmax(0,1fr)}
  .arrow{transform:rotate(90deg);height:30px}
  .topbar,.intro,.steps,.foot{padding-inline:18px}
  .stepper{padding-inline:18px}
}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}

:root{--r0:#3f9f5a;--r1:#a3cf65;--r2:#f3e35a;--r3:#f2b544;--r4:#e2452f;--r5:#7a1712;--fcab:#e07a2f;--fcab-s:rgba(224,122,47,.10)}
