<script>
var LOGO_FCAB="data:image/png;base64,";
document.getElementById('ld-logo-img').src=LOGO_FCAB;
document.getElementById('topbar-logo-img').src=LOGO_FCAB;

/* ---------- klassen (kleuren conform FCAB SLD) ---------- */
var KL = [
  {key:'0 tot 2 cm',    label:'Droge voeten (0 tot 2 cm)', short:'Geen',      legenda:'Geen (0 tot 2 cm)',       color:'#ffffff'},
  {key:'2 tot 10 cm',   label:'Zeer laag (2-10 cm)',          short:'Zeer laag', legenda:'Zeer laag (2 tot 10 cm)', color:'#ffbebe'},
  {key:'10 tot 15 cm',  label:'Laag (10-15 cm)',              short:'Laag',      legenda:'Laag (10 tot 15 cm)',     color:'#ff7f7f'},
  {key:'15 tot 20 cm',  label:'Middel (15-20 cm)',            short:'Middel',    legenda:'Middel (15 tot 20 cm)',   color:'#ff0000'},
  {key:'20 tot 30 cm',  label:'Hoog (20-30 cm)',              short:'Hoog',      legenda:'Hoog (20 tot 30 cm)',     color:'#700000'},
  {key:'meer dan 30 cm',label:'Zeer hoog (> 30 cm)',          short:'Zeer hoog', legenda:'Zeer hoog (> 30 cm)',     color:'#280000'},
  {key:'Onbekend',      label:'Onbekend',                     short:'Onbekend',  legenda:'Onbekend',                color:'#b2b2b2'}
];
var NODATA = '#b2b2b2';

/* Droge-voetenklassen: aandeel panden dat droog blijft (waterdiepte onder 2 cm).
   Van nat naar droog, zodat de filters "natter dan" kunnen werken. */
var DROOG = [
  {short:'Laarzen aan',       legenda:'Laarzen aan (minder dan 25%)',       color:'#1d5fa8'},
  {short:'Vaak natte voeten', legenda:'Vaak natte voeten (25 tot 50%)',     color:'#5a95cd'},
  {short:'Soms natte voeten', legenda:'Soms natte voeten (50 tot 70%)',     color:'#b7d2e8'},
  {short:'Meestal droog',     legenda:'Meestal droog (70 tot 85%)',         color:'#dfe7cc'},
  {short:'Vrijwel droog',     legenda:'Vrijwel droog (85 tot 95%)',         color:'#7ab08a'},
  {short:'Droge voeten',      legenda:'Droge voeten (95% of meer)',         color:'#1a6e3c'}
];
var GRENZEN = [25, 50, 70, 85, 95];   // % panden dat droog blijft
function klasseVan(pct){
  if (pct===null || pct===undefined) return -1;
  for (var i=0;i<GRENZEN.length;i++){ if (pct < GRENZEN[i]) return i; }
  return 5;
}

/* ---------- weergaven ---------- */
var MIN_BEKEND = 10;   // onder deze grens is een percentage niet betrouwbaar
var MIN_LIJST = 50;    // drempel voor lijst en ranglijst

function bekendVan(k){ return k[0]+k[1]+k[2]+k[3]+k[4]+k[5]; }

function shareFrom(k, from){
  var bek = bekendVan(k), sel = 0;
  for (var i=from;i<6;i++) sel += k[i];
  return bek>0 ? sel/bek*100 : null;
}
/* percentage alleen tonen als er genoeg panden met bekende diepte zijn */
function shareSafe(k, from){
  return bekendVan(k) >= MIN_BEKEND ? shareFrom(k, from) : null;
}
/* de kaart toont per buurt het aandeel panden dat droge voeten houdt:
   panden in de FCAB-klasse 0 tot 2 cm, als % van de panden met een bekende diepte */
function droogAandeel(k){
  var bek = bekendVan(k);
  return bek>0 ? k[0]/bek*100 : null;
}
var view = {
  label: 'Droge voeten per buurt',
  val: function(f){ return bekendVan(f.k) >= MIN_BEKEND ? droogAandeel(f.k) : null; },
  foot: 'Aandeel panden dat bij een bui van 70 mm in 1 uur droog blijft (waterdiepte onder 2 cm), als % van de panden met een bekende diepte.'
};
var mode = 'buurt';
var activeFilter = 'all';
var minPanden = true;
var selected = null;
var map, layerGroup, tip, RENDERER;
var F = [], GEM = [], layers = [], rankIdx = {};

/* ---------- payload decoderen ---------- */
function decode(){
  var raw = JSON.parse(document.getElementById('payload').textContent);
  var q = raw.q;
  raw.f.forEach(function(o, idx){
    var polys = [];
    for (var p=0;p<o.g.length;p++){
      var rings = [];
      for (var r=0;r<o.g[p].length;r++){
        var flat = o.g[p][r];
        var pts = [];
        var x = flat[0], y = flat[1];
        pts.push([y/q, x/q]);
        for (var i=2;i<flat.length;i+=2){
          x += flat[i]; y += flat[i+1];
          pts.push([y/q, x/q]);
        }
        rings.push(pts);
      }
      polys.push(rings);
    }
    F.push({
      i: idx, c:'BU'+o.c, n:o.n, w:o.w, m:o.m, a:o.a, k:o.k,
      gd:o.gd, xd:o.xd, wt:o.wt, t:o.k.reduce(function(a,b){return a+b;},0),
      poly: polys
    });
  });
}

/* ---------- gemeenten aggregeren ---------- */
function buildGemeenten(){
  var byName = {};
  F.forEach(function(f){
    var g = byName[f.m];
    if (!g){ g = byName[f.m] = {m:f.m, n:f.m, k:[0,0,0,0,0,0,0], t:0, wsum:0, nb:0, buurten:[], xd:0}; }
    for (var i=0;i<7;i++) g.k[i]+=f.k[i];
    g.t += f.t;
    var bek = f.k.slice(0,6).reduce(function(a,b){return a+b;},0);
    if (f.gd!=null && bek>0){ g.wsum += f.gd*bek; g.nb += bek; }
    if (f.xd!=null && f.xd>g.xd) g.xd = f.xd;
    g.buurten.push(f.i);
  });
  GEM = Object.keys(byName).map(function(k){
    var g = byName[k];
    g.gd = g.nb>0 ? g.wsum/g.nb : null;
    return g;
  });
}

/* ---------- kleuren ---------- */
function colorFor(v){
  var i = klasseVan(v);
  return i < 0 ? NODATA : DROOG[i].color;
}
function klasseNaam(v){
  var i = klasseVan(v);
  return i < 0 ? 'onbekend' : DROOG[i].short;
}
function fmtVal(v){
  if (v===null||v===undefined) return '–';
  return v.toFixed(1).replace('.',',') + '% droog';
}
function fmtNum(n){ return (n||0).toLocaleString('nl-NL'); }
function fmtPct(v,dec){ return v===null||v===undefined?'–':v.toFixed(dec===undefined?1:dec).replace('.',',')+'%'; }

/* ---------- kaart ---------- */
function initMap(){
  map = L.map('map',{preferCanvas:true, zoomControl:true}).setView([52.15,5.4],7);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
    attribution: isMobiel()
      ? '&copy; OpenStreetMap &middot; CBS/PDOK &middot; FCAB'
      : '&copy; OpenStreetMap &middot; buurten: CBS/PDOK &middot; wateroverlast: FCAB Omgevingsscore',
    maxZoom:18
  }).addTo(map);
  RENDERER = L.canvas({padding:0.2});
  layerGroup = L.layerGroup().addTo(map);
  tip = document.getElementById('tip');
  map.invalidateSize();

  F.forEach(function(f){
    var rings = [];
    for (var pi=0; pi<f.poly.length; pi++){
      for (var ri=0; ri<f.poly[pi].length; ri++) rings.push(f.poly[pi][ri]);
    }
    var poly = L.polygon(rings, {
      renderer: RENDERER, stroke:true, color:'#2f2f2f', weight:0.3, opacity:0.55,
      fillColor: NODATA, fillOpacity:0.75, interactive:true, smoothFactor:1.5
    });
    poly._f = f;
    poly.on('mouseover', function(e){ hoverOn(f, e); });
    poly.on('mousemove', function(e){ moveTip(e); });
    poly.on('mouseout', function(){ hoverOff(); });
    poly.on('click', function(){ selectFeature(f, false); });
    layers.push(poly);
    poly.addTo(layerGroup);
  });
  map.fitBounds([[50.72,3.3],[53.6,7.25]]);
  map.on('zoomend', function(){
    var lv = styleLevel();
    if (lv.w+'|'+lv.fo !== lastLevel) restyle();
  });
}

function hoverOn(f, e){
  var v = view.val(f);
  tip.innerHTML = '<div><b>'+esc(f.n||f.c)+'</b></div>'+
    '<div class="ht-sub">'+esc(f.m)+(f.w&&f.w!==f.n?' &middot; '+esc(f.w):'')+'</div>'+
    '<div class="ht-val">'+klasseNaam(v)+' · '+fmtVal(v)+'</div>'+
    '<div class="ht-sub">'+fmtNum(f.t)+' panden</div>';
  tip.style.display='block';
  moveTip(e);
}
function moveTip(e){
  if (!e.originalEvent) return;
  var box = document.querySelector('.map-container').getBoundingClientRect();
  var x = e.originalEvent.clientX - box.left + 14;
  var y = e.originalEvent.clientY - box.top + 14;
  if (x > box.width-250) x -= 264;
  if (y > box.height-90) y -= 100;
  tip.style.left = x+'px'; tip.style.top = y+'px';
}
function hoverOff(){ tip.style.display='none'; }

/* selectie: zoekterm + klassefilter (werkt op kaart en lijst).
   De filters zoeken de natste buurten op, dus klasse t/m de gekozen grens. */
function inSelection(f){
  if (activeFilter!=='all'){
    var kl = klasseVan(view.val(f));
    if (kl < 0 || kl > parseInt(activeFilter)) return false;
  }
  var q = document.getElementById('q').value.trim().toLowerCase();
  if (q.length>1){
    var hay = ((f.n||'')+' '+(f.m||'')+' '+(f.w||'')+' '+(f.c||'')).toLowerCase();
    if (hay.indexOf(q)===-1) return false;
  }
  return true;
}
/* lijst/ranglijst: bovendien de databetrouwbaarheidsdrempel */
function inList(f){
  if (!inSelection(f)) return false;
  if (minPanden && bekendVan(f.k) < MIN_LIJST) return false;
  return true;
}

var WATER_FILL = '#dde4e9', NODATA_FILL = '#d3cec8';
var lastLevel = null;
/* zoomniveau bepaalt grenslijn en dekking: uitgezoomd een vlakke choropleth,
   ingezoomd dunner en transparanter zodat de ondergrond leesbaar blijft */
function styleLevel(){
  var z = map ? map.getZoom() : 7;
  if (z < 9)  return {w:0,   fo:0.82};
  if (z < 12) return {w:0.3, fo:0.78};
  if (z < 14) return {w:0.6, fo:0.62};
  return {w:0.8, fo:0.45};
}

function restyle(){
  var dim = (activeFilter!=='all') || (document.getElementById('q').value.trim().length>1);
  var lv = styleLevel();
  var w = lv.w;
  lastLevel = lv.w+'|'+lv.fo;
  for (var i=0;i<layers.length;i++){
    var f = layers[i]._f;
    var v = view.val(f);
    var inSel = inSelection(f);
    var isSel = selected && selected.type==='buurt' && selected.f===f;
    var noData = (v===null || v===undefined);
    var isWater = f.wt===1 || f.t===0;
    layers[i].setStyle({
      fillColor: noData ? (isWater ? WATER_FILL : NODATA_FILL) : colorFor(v),
      fillOpacity: (dim && !inSel) ? 0.08 : (noData ? Math.min(0.5, lv.fo) : lv.fo),
      color: isSel ? '#1d5fa8' : '#4a453d',
      weight: isSel ? 2.4 : w,
      opacity: (dim && !inSel) ? 0.12 : (isSel ? 1 : 0.4)
    });
    if (isSel) layers[i].bringToFront();
  }
}

function gemInSelection(g){
  var q = document.getElementById('q').value.trim().toLowerCase();
  if (q.length>1 && (g.m||'').toLowerCase().indexOf(q)===-1) return false;
  if (activeFilter!=='all'){
    var kl = klasseVan(view.val(g));
    if (kl < 0 || kl > parseInt(activeFilter)) return false;
  }
  return true;
}

/* ---------- lijst ---------- */
function currentRows(){
  var rows;
  if (mode==='buurt'){
    rows = F.filter(inList);
  } else {
    rows = GEM.filter(gemInSelection);
  }
  var sort = document.getElementById('sort-sel').value;
  if (sort==='naam'){
    rows.sort(function(a,b){ return (a.n||'').localeCompare(b.n||'','nl'); });
  } else if (sort==='panden'){
    rows.sort(function(a,b){ return b.t-a.t; });
  } else if (sort==='nat'){
    rows.sort(function(a,b){
      var va = view.val(a), vb = view.val(b);
      if (va===null) va=999; if (vb===null) vb=999;
      return va-vb;
    });
  } else {
    rows.sort(function(a,b){
      var va = view.val(a), vb = view.val(b);
      if (va===null) va=-1; if (vb===null) vb=-1;
      return vb-va;
    });
  }
  return rows;
}

function renderList(){
  var rows = currentRows();
  var el = document.getElementById('list');
  var lbl = mode==='buurt' ? 'buurten' : 'gemeenten';
  document.getElementById('list-count').textContent =
    fmtNum(rows.length)+' '+lbl+' in selectie'+(rows.length>250?' · top 250 getoond':'')+
    (mode==='gemeente' ? ' · kaart blijft op buurtniveau' : '');
  var show = rows.slice(0,250);
  if (!show.length){
    el.innerHTML = '<div class="list-hint">Geen resultaten. Pas je zoekopdracht of filter aan.</div>';
    return;
  }
  var html = '';
  for (var i=0;i<show.length;i++){
    var r = show[i];
    var v = view.val(r);
    var sub = mode==='buurt'
      ? esc(r.m)+' · '+fmtPct(v)+' droog'
      : fmtNum(r.buurten.length)+' buurten · '+fmtPct(v)+' droog';
    html += '<div class="li'+(selected&&selected.r===r?' active':'')+'" data-i="'+i+'">'+
      '<div class="li-rank">'+(i+1)+'</div>'+
      '<div class="li-body"><div class="li-name">'+esc(r.n||r.c)+'</div>'+
      '<div class="li-sub">'+sub+'</div></div>'+
      '</div>';
  }
  el.innerHTML = html;
  window._rows = show;
}
function pickFg(hex){
  var r=parseInt(hex.substr(1,2),16),g=parseInt(hex.substr(3,2),16),b=parseInt(hex.substr(5,2),16);
  return (0.299*r+0.587*g+0.114*b) > 150 ? '#1c1a17' : '#ffffff';
}
function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]; }); }

/* ---------- detail ---------- */
function selectFeature(r, fromList){
  var isBuurt = mode==='buurt' ? true : (r.buurten===undefined);
  if (r.buurten!==undefined){ showGemeente(r); }
  else { showBuurt(r); }
  selected = {type: r.buurten!==undefined?'gemeente':'buurt', r:r, f: r.buurten!==undefined?null:r};
  restyle();
  document.getElementById('detail').classList.add('open');
  document.getElementById('panel').classList.add('detail-open');
  document.getElementById('list').style.display='none';
  if (!fromList){
    renderList();
    if (isMobiel() && sheetState==='collapsed') setSheet('half');
  }
}

function klassenRows(k, totBekend){
  var html = '';
  for (var i=0;i<7;i++){
    var n = k[i];
    var denom = i===6 ? k.reduce(function(a,b){return a+b;},0) : totBekend;
    var pct = denom>0 ? n/denom*100 : 0;
    html += '<div class="kl-row">'+
      '<div class="kl-sw" style="background:'+KL[i].color+'"></div>'+
      '<div class="kl-name">'+KL[i].label+'</div>'+
      '<div class="kl-bar"><div style="width:'+Math.min(100,pct).toFixed(1)+'%;background:'+(i===6?NODATA:KL[i].color)+'"></div></div>'+
      '<div class="kl-num">'+fmtNum(n)+' &middot; '+pct.toFixed(1).replace('.',',')+'%</div>'+
      '</div>';
  }
  return html;
}

function showBuurt(f){
  var bek = bekendVan(f.k);
  document.getElementById('d-name').textContent = f.n || f.c;
  document.getElementById('d-sub').textContent = (f.w && f.w!==f.n ? f.w+' · ' : '')+f.m;
  document.getElementById('d-sub2').textContent = f.c+' · '+f.a.toFixed(0)+' ha · '+
    fmtNum(bek)+' van '+fmtNum(f.t)+' panden met bekende diepte'+(f.wt?' · waterbuurt':'');
  var v = view.val(f);
  document.getElementById('d-kpis').innerHTML =
    kpi(fmtNum(f.t),'panden')+
    kpi(fmtNum(f.k[0]),'blijven droog')+
    kpiKlasse(v);
  document.getElementById('d-klassen').innerHTML = klassenRows(f.k, bek);

  var gem = GEM.filter(function(g){ return g.m===f.m; })[0];
  var gemV = gem ? view.val(gem) : null;
  var nlDroog = droogAandeel(rankIdx.nlK);
  var html = '';
  if (v!==null){
    html += 'Van de '+fmtNum(bek)+' panden met een bekende waterdiepte houden er <b>'+
      fmtNum(f.k[0])+'</b> droge voeten: <b>'+fmtPct(v)+'</b>. Landelijk is dat <b>'+fmtPct(nlDroog)+'</b>.<br>';
  }
  if (v!==null && bek >= MIN_LIJST){
    var rank = rankIdx.buurt.indexOf(f.i)+1;
    html += 'Landelijke positie op droge voeten: <b>#'+fmtNum(rank)+'</b> van '+
      fmtNum(rankIdx.buurt.length)+' buurten met minstens '+MIN_LIJST+' bekende panden.<br>';
  } else if (v===null){
    html += 'Te weinig panden met een bekende waterdiepte ('+fmtNum(bek)+
      ') om hier iets over de voeten te zeggen.<br>';
  } else {
    html += 'Deze buurt heeft '+fmtNum(bek)+' panden met bekende diepte. Dat is te weinig voor de landelijke ranglijst.<br>';
  }
  if (v!==null && gemV!==null){
    var vgl = v>gemV ? 'droger' : (v<gemV ? 'natter' : 'gelijk');
    html += 'Gemeente '+esc(f.m)+' zit gemiddeld op <b>'+fmtPct(gemV)+'</b> droog, deze buurt is '+vgl+'.<br>';
  }
  if (f.k[6]>0){
    html += 'Van <b>'+fmtNum(f.k[6])+'</b> panden ('+
      (f.t>0?(f.k[6]/f.t*100).toFixed(1).replace('.',','):'0')+'%) is de waterdiepte onbekend.<br>';
  }
  if (f.xd!=null){
    if (f.xd < 2){
      html += 'Zelfs de natste plek in deze buurt blijft onder de 2 cm.';
    } else {
      html += 'Natste plek in deze buurt: <b>'+f.xd.toFixed(0)+' cm</b>'+
        (f.xd>=50 ? '. Daar helpen laarzen niet meer.' : ' (p99).');
    }
  }
  document.getElementById('d-context').innerHTML = html || 'Geen panden met een bekende waterdiepte in deze buurt.';
  document.getElementById('d-zoom').onclick = function(){
    var lyr = layers[f.i];
    map.fitBounds(lyr.getBounds(), {maxZoom:15, padding:[30,30]});
  };
}

function showGemeente(g){
  var bek = bekendVan(g.k);
  document.getElementById('d-name').textContent = g.m;
  document.getElementById('d-sub').textContent = fmtNum(g.buurten.length)+' buurten';
  document.getElementById('d-sub2').textContent = fmtNum(bek)+' van '+fmtNum(g.t)+' panden met bekende diepte';
  var v = view.val(g);
  document.getElementById('d-kpis').innerHTML =
    kpi(fmtNum(g.t),'panden')+
    kpi(fmtNum(g.k[0]),'blijven droog')+
    kpiKlasse(v);
  document.getElementById('d-klassen').innerHTML = klassenRows(g.k, bek);

  var nat = g.buurten.map(function(i){ return F[i]; })
    .filter(function(f){ return bekendVan(f.k) >= MIN_LIJST && view.val(f)!==null; })
    .sort(function(a,b){ return view.val(a)-view.val(b); })
    .slice(0,5);
  var nlDroog = droogAandeel(rankIdx.nlK);
  var html = '';
  if (v!==null){
    html += 'In deze gemeente houden <b>'+fmtNum(g.k[0])+'</b> van de '+fmtNum(bek)+
      ' panden droge voeten: <b>'+fmtPct(v)+'</b>. Landelijk is dat <b>'+fmtPct(nlDroog)+'</b>.<br>';
  }
  if (nat.length){
    html += 'Hier zijn laarzen het hardst nodig (≥ '+MIN_LIJST+' bekende panden):<br>';
    nat.forEach(function(f){
      html += '&bull; '+esc(f.n)+': <b>'+fmtPct(view.val(f))+'</b> droog ('+fmtNum(f.t)+' panden)<br>';
    });
  }
  document.getElementById('d-context').innerHTML = html;
  document.getElementById('d-zoom').onclick = function(){
    var b = null;
    g.buurten.forEach(function(i){
      var bb = layers[i].getBounds();
      b = b ? b.extend(bb) : L.latLngBounds(bb.getSouthWest(), bb.getNorthEast());
    });
    if (b) map.fitBounds(b, {padding:[30,30]});
  };
}
function kpi(num,lbl){ return '<div class="d-kpi"><div class="d-kpi-num">'+num+'</div><div class="d-kpi-lbl">'+lbl+'</div></div>'; }
function kpiKlasse(v){
  var i = klasseVan(v);
  var col = i<0 ? NODATA : KL[i].color;
  return '<div class="d-kpi" style="background:'+col+';border-color:rgba(0,0,0,.2)">'+
    '<div class="d-kpi-num d-kpi-klasse" style="color:'+pickFg(col)+'">'+klasseNaam(v)+'</div>'+
    '<div class="d-kpi-lbl" style="color:'+pickFg(col)+';opacity:.75">FCAB-klasse</div></div>';
}

function closeDetail(){
  document.getElementById('detail').classList.remove('open');
  document.getElementById('panel').classList.remove('detail-open');
  document.getElementById('list').style.display='';
  selected = null;
  restyle(); renderList();
}

function renderStats(){
  var rows = F.filter(inSelection);
  var vals = rows.map(function(f){ return view.val(f); }).filter(function(v){ return v!==null&&v!==undefined; });
  var gem = vals.length ? vals.reduce(function(a,b){return a+b;},0)/vals.length : null;
  var mn = vals.length ? Math.min.apply(null, vals) : null;
  document.getElementById('stats-bar').innerHTML =
    '<div class="stat-card"><div class="stat-num">'+fmtNum(rows.length)+'</div><div class="stat-lbl">buurten op kaart</div></div>'+
    '<div class="stat-card"><div class="stat-num">'+(gem===null?'–':fmtPct(gem))+'</div><div class="stat-lbl">gemiddeld droog</div></div>'+
    '<div class="stat-card"><div class="stat-num" style="color:var(--blue)">'+(mn===null?'–':fmtPct(mn))+'</div><div class="stat-lbl">natste buurt</div></div>';
}

function renderLegend(){
  document.getElementById('legend-title').textContent = view.label;
  var html = '';
  for (var i=5;i>=0;i--) html += legItem(DROOG[i].color, DROOG[i].legenda);
  html += legItem(NODATA_FILL,'geen of te weinig data');
  html += legItem(WATER_FILL,'waterbuurt');
  document.getElementById('legend-items').innerHTML = html;
  document.getElementById('legend-foot').textContent = view.foot;
}
function legItem(c,t){ return '<div class="legend-item"><div class="legend-sw" style="background:'+c+'"></div>'+t+'</div>'; }

function buildViewControls(){
  var s = document.getElementById('sort-sel');
  s.innerHTML = '<option value="view">Sorteer: droogste eerst</option>'+
    '<option value="nat">Sorteer: natste eerst</option>'+
    '<option value="panden">Sorteer: aantal panden</option>'+
    '<option value="naam">Sorteer: naam (A-Z)</option>';
}

function refreshAll(){
  restyle(); renderList(); renderStats(); renderLegend();
  if (selected){
    if (selected.type==='buurt') showBuurt(selected.r); else showGemeente(selected.r);
  }
}

/* ---------- init ---------- */
function boot(){
  var t0 = performance.now();
  /* app zichtbaar maken vóór de kaart wordt gebouwd (anders kent de container geen maat);
     de loader blijft er als overlay bovenop staan tot alles klaar is */
  document.getElementById('app').style.display = 'flex';
  decode();
  var t1 = performance.now();
  buildGemeenten();
  var nlK=[0,0,0,0,0,0,0];
  F.forEach(function(f){ for(var i=0;i<7;i++) nlK[i]+=f.k[i]; });
  rankIdx.nlK = nlK;
  rankIdx.buurt = F.filter(function(f){ return bekendVan(f.k) >= MIN_LIJST; })
    .sort(function(a,b){
      var x=view.val(a), y=view.val(b);
      return (y===null?-1:y)-(x===null?-1:x);
    }).map(function(f){ return f.i; });

  buildViewControls();
  initMobiel();
  if (isMobiel()) setSheet('collapsed');
  var t2 = performance.now();
  initMap();
  var t3 = performance.now();
  refreshAll();
  var t4 = performance.now();
  console.log('boot ms, decode:'+(t1-t0|0)+' prep:'+(t2-t1|0)+' kaart:'+(t3-t2|0)+' render:'+(t4-t3|0));

  var qTimer=null;
  document.getElementById('q').addEventListener('input', function(){
    clearTimeout(qTimer); qTimer = setTimeout(refreshAll, 220);
  });
  document.getElementById('sort-sel').addEventListener('change', renderList);
  document.getElementById('chk-min').addEventListener('change', function(){
    minPanden = this.checked; refreshAll();
  });
  document.getElementById('filter-row').addEventListener('click', function(e){
    var b = e.target.closest('.filter-btn'); if(!b) return;
    Array.prototype.forEach.call(document.querySelectorAll('.filter-btn'), function(x){ x.classList.remove('on'); });
    b.classList.add('on'); activeFilter = b.dataset.f; refreshAll();
  });
  Array.prototype.forEach.call(document.querySelectorAll('.tab'), function(t){
    t.addEventListener('click', function(){
      Array.prototype.forEach.call(document.querySelectorAll('.tab'), function(x){ x.classList.remove('on'); });
      t.classList.add('on'); mode = t.dataset.mode;
      document.getElementById('chk-min').parentNode.style.display = mode==='buurt'?'':'none';
      selected=null; closeDetailSilent(); refreshAll();
    });
  });
  document.getElementById('list').addEventListener('click', function(e){
    var li = e.target.closest('.li'); if(!li||!window._rows) return;
    var r = window._rows[parseInt(li.dataset.i)]; if(!r) return;
    selectFeature(r, true);
    if (isMobiel()) setSheet('half');
    var pad = isMobiel() ? [20,20] : [30,30];
    if (r.buurten===undefined){
      map.fitBounds(layers[r.i].getBounds(), {maxZoom:14, padding:pad});
    } else {
      document.getElementById('d-zoom').onclick();
    }
  });
  document.getElementById('d-close').addEventListener('click', closeDetail);

  document.getElementById('loader').style.display='none';
  setTimeout(function(){
    map.invalidateSize();
    map.fitBounds([[50.72,3.3],[53.6,7.25]]);
  }, 60);
}
function closeDetailSilent(){
  document.getElementById('detail').classList.remove('open');
  document.getElementById('panel').classList.remove('detail-open');
  document.getElementById('list').style.display='';
}

/* ---------- mobiel ---------- */
function isMobiel(){
  return window.matchMedia('(max-width:820px)').matches;
}
var sheetState = 'half';
function setSheet(s){
  sheetState = s;
  var p = document.getElementById('panel');
  p.classList.remove('sheet-collapsed','sheet-half','sheet-full');
  p.classList.add('sheet-'+s);
  setTimeout(function(){ if (map) map.invalidateSize(); }, 260);
}
function initMobiel(){
  document.getElementById('sheet-handle').addEventListener('click', function(){
    setSheet(sheetState==='collapsed' ? 'half' : (sheetState==='half' ? 'full' : 'collapsed'));
  });
  var lg = document.getElementById('legend');
  document.getElementById('legend-head').addEventListener('click', function(){
    if (isMobiel()) lg.classList.toggle('collapsed');
  });
  if (isMobiel()) lg.classList.add('collapsed');

  var t = null;
  function herbereken(){
    clearTimeout(t);
    t = setTimeout(function(){
      if (!map) return;
      map.invalidateSize();
      if (!isMobiel()) document.getElementById('legend').classList.remove('collapsed');
    }, 180);
  }
  window.addEventListener('resize', herbereken);
  window.addEventListener('orientationchange', herbereken);
}

window.addEventListener('load', function(){ setTimeout(boot, 30); });
</script>
</body>
